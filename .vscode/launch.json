{
    "configurations": [
        {
            "name": "Windows Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/template/build/bin/RelWithDebInfo/launcher.exe",
            "args": [
                "http://localhost:8899/index.js"
            ],
            "stopAtEntry": false,
            //"cwd": "${fileDirname}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "conchjs",
            "type": "node",
            "request": "attach",
            "port": 5959,
            "address": "localhost",
        },      
        {
            "name": "(gdb) 启动",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/builddbg/template/Debug/launcher",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "compounds": [
        {
            "name": "C++和v8",
            "configurations": ["Windows Launch", "conchjs"]
        }
    ]    
}